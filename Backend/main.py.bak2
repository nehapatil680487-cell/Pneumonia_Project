        <div class="field-group">
          <p class="section-label">Patient Information</p>
          <div class="grid grid-3">
            <div>
              <label>Patient Name</label>
              <input type="text" name="patient_name" placeholder="e.g. John Carter" required>
            </div>
            <div>
              <label>Age</label>
              <input type="number" name="age" placeholder="e.g. 34" required>
            </div>
            <div>
              <label>Gender</label>
              <input type="text" name="gender" placeholder="Male / Female / Other" required>
            </div>
          </div>
        </div>

        <div class="field-group">
          <p class="section-label">Chest X-Ray Image</p>
          <div class="upload-box">
            <div class="upload-icon">📤</div>
            <input type="file" name="file" accept="image/*" required>
            <div class="upload-hint">JPG or PNG &middot; the image will be analyzed by the AI model</div>
          </div>
        </div>

        <div class="field-group">
          <p class="section-label">Lab Values <span style="text-transform:none;font-weight:500;font-size:12px;color:#94a3b8;"></span></p>
          <div class="grid grid-4">
            <div>
              <label>WBC (cells/µL)</label>
              <input type="text" name="wbc" placeholder="e.g. 8200">
            </div>
            <div>
              <label>RBC (mill/µL)</label>
              <input type="text" name="rbc" placeholder="e.g. 4.8">
            </div>
            <div>
              <label>Platelets (×10³/µL)</label>
              <input type="text" name="platelet" placeholder="e.g. 250">
            </div>
            <div>
              <label>Hemoglobin (g/dL)</label>
              <input type="text" name="hb" placeholder="e.g. 13.5">
            </div>
          </div>
        </div>

        <div class="field-group">
          <p class="section-label">Vitals <span style="text-transform:none;font-weight:500;font-size:12px;color:#94a3b8;"></span></p>
          <div class="grid grid-3">
            <div>
              <label>Temperature (°F)</label>
              <input type="text" name="temperature" placeholder="e.g. 98.6">
            </div>
            <div>
              <label>SpO2 (%)</label>
              <input type="text" name="spo2" placeholder="e.g. 97">
            </div>
            <div>
              <label>Pulse Rate (bpm)</label>
              <input type="text" name="pulse_rate" placeholder="e.g. 78">
            </div>
          </div>
        </div>

      <div class="field-group">
    <p class="section-label">CAP Severity Assessment</p>

    <div class="grid grid-3">
        <div>
            <label>CRP (mg/L)</label>
            <input type="text" name="crp" placeholder="e.g. 24.5">
        </div>
    </div>

    <div class="upload-hint" style="margin-top:8px;">
        Used as one of the clinical parameters for CAP severity assessment
        after pneumonia is detected.
    </div>
</div>

        <label style="display:flex;gap:8px;align-items:center;font-weight:600;margin-bottom:18px;">
          <input type="checkbox" name="save_for_autofill" value="1" style="width:auto;">
          Remember this patient (auto-fill when this X-ray is uploaded again)
