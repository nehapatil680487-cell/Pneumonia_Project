# =========================
# PREPROCESS IMAGE
# =========================
def preprocess(file_bytes):
    img = cv2.imdecode(np.frombuffer(file_bytes, np.uint8), cv2.IMREAD_COLOR)

    if img is None:
        raise ValueError("Invalid image")

    img = cv2.resize(img, (IMG_SIZE, IMG_SIZE))
    img_norm = img.astype("float32") / 255.0

    return img, np.expand_dims(img_norm, axis=0)


def get_last_conv(model):
    last_name = None
    layer_owner = model

    def scan(m):
        nonlocal last_name, layer_owner
        for layer in m.layers:
            if isinstance(layer, tf.keras.layers.Conv2D):
                last_name = layer.name
                layer_owner = m
            elif isinstance(layer, tf.keras.Model):
                scan(layer)

    scan(model)
    return last_name, layer_owner


REFERENCE_RANGES = {
    "wbc":         {"label": "WBC",          "unit": "cells/mcL", "low": 4000,  "high": 11000},
    "rbc":         {"label": "RBC",          "unit": "mill/mcL",  "low": 4.2,   "high": 5.9},
    "platelet":    {"label": "Platelets",    "unit": "x10<super>3</super>/mcL", "low": 150,  "high": 450},
    "hb":          {"label": "Hemoglobin",   "unit": "g/dL",      "low": 12.0,  "high": 17.5},
    "temperature": {"label": "Temperature",  "unit": "\u00b0F",   "low": 97.0,  "high": 99.0},
    "spo2":        {"label": "SpO2",         "unit": "%",         "low": 95,    "high": 100},
    "pulse_rate":  {"label": "Pulse Rate",   "unit": "bpm",       "low": 60,    "high": 100},
    "crp":         {"label": "CRP",          "unit": "mg/L",      "low": 0,     "high": 10},
}


def evaluate_value(key, raw_value):
    ref = REFERENCE_RANGES[key]
    label = ref["label"]
    unit = ref["unit"]
    range_str = f"{ref['low']} - {ref['high']}"

    raw_str = "" if raw_value is None else str(raw_value).strip()

    if raw_str == "":
        return {
            "label": label, "value": "-", "unit": unit,
            "range": range_str, "flag": "N/A"
        }

    try:
        value = float(raw_str)
    except (ValueError, TypeError):
        return {
            "label": label, "value": "-", "unit": unit,
            "range": range_str, "flag": "N/A"
        }

    unit_warning = None

    if key == "platelet" and value > 1000:
        value = value / 1000.0
        unit_warning = "auto-converted from absolute count to x10\u00b3/mcL"
    elif key == "temperature" and 30 <= value <= 45:
        value = value * 9 / 5 + 32
        unit_warning = "auto-converted from \u00b0C to \u00b0F"

    if value < ref["low"]:
        flag = "Low"
    elif value > ref["high"]:
        flag = "High"
    else:
        flag = "Normal"

    value_str = f"{value:g}"
    if unit_warning:
        value_str += " *"

    return {
        "label": label, "value": value_str, "unit": unit,
        "range": range_str, "flag": flag, "unit_warning": unit_warning
    }


def evaluate_all_vitals(vitals):
    order = ["temperature", "spo2", "pulse_rate", "wbc", "rbc", "platelet", "hb", "crp"]
    return [evaluate_value(key, vitals.get(key, "")) for key in order]


# =========================
# STAGE 1: MULTIMODAL PNEUMONIA DETECTION
# =========================

def predict_blood_ann(age_raw, hb_raw, platelet_raw, wbc_raw, rbc_raw):
    if blood_model is None or blood_scaler is None:
        return {"available": False, "reason": "Blood ANN model unavailable."}

    required = {"Hemoglobin": hb_raw, "Platelets": platelet_raw, "WBC": wbc_raw, "RBC": rbc_raw}
    missing = [k for k, v in required.items() if str(v).strip() == ""]
    if missing:
        return {"available": False, "reason": f"Missing required value(s) for Blood ANN: {', '.join(missing)}."}

    try:
        hb = float(hb_raw)
        platelet_k = float(platelet_raw)
        wbc = float(wbc_raw)
        rbc = float(rbc_raw)
    except (ValueError, TypeError):
        return {"available": False, "reason": "Blood ANN inputs could not be parsed as numbers."}

    platelet_absolute = platelet_k * 1000.0

    try:
        age = float(age_raw)
    except (ValueError, TypeError):
        age = _blood_mean.get("Age", 40.0)

    feature_values = {
        "Age": age,
        "Gender": _blood_mean.get("Gender", 0.5),
        "Hemoglobin": hb,
        "Platelet_Count": platelet_absolute,
        "White_Blood_Cells": wbc,
        "Red_Blood_Cells": rbc,
        "MCV": _blood_mean.get("MCV"),
        "MCH": _blood_mean.get("MCH"),
        "MCHC": _blood_mean.get("MCHC"),
    }

    try:
        X = np.array([[feature_values[f] for f in BLOOD_FEATURE_ORDER]], dtype="float32")
        X_scaled = blood_scaler.transform(X)
        prob = float(blood_model.predict(X_scaled, verbose=0).squeeze())
        return {"available": True, "prob": prob, "is_positive": prob > 0.5, "partial_profile": True}
    except Exception as e:
        print("Blood ANN prediction error:", e)
        return {"available": False, "reason": "Blood ANN prediction failed."}


def predict_oxygen_ann(spo2_raw, pulse_rate_raw, temperature_raw):
    if oxygen_model is None or oxygen_scaler is None:
        return {"available": False, "reason": "Oxygen ANN model unavailable."}

    required = {"SpO2": spo2_raw, "Pulse Rate": pulse_rate_raw, "Temperature": temperature_raw}
    missing = [k for k, v in required.items() if str(v).strip() == ""]
    if missing:
        return {"available": False, "reason": f"Missing required value(s) for Oxygen ANN: {', '.join(missing)}."}

    try:
        spo2 = float(spo2_raw)
        pulse_rate = float(pulse_rate_raw)
        temperature = float(temperature_raw)
    except (ValueError, TypeError):
        return {"available": False, "reason": "Oxygen ANN inputs could not be parsed as numbers."}

    try:
        X = np.array([[spo2, pulse_rate, temperature]], dtype="float32")
        X_scaled = oxygen_scaler.transform(X)
        probs = oxygen_model.predict(X_scaled, verbose=0).squeeze()
        probs = [float(p) for p in probs]
        class_idx = int(np.argmax(probs))
        class_label = OXYGEN_CLASS_LABELS[class_idx]
        is_positive = class_idx in (1, 2)
        return {
            "available": True,
            "class_label": class_label,
            "class_probs": probs,
            "is_positive": is_positive,
            "confidence": probs[class_idx] * 100,
        }
    except Exception as e:
        print("Oxygen ANN prediction error:", e)
        return {"available": False, "reason": "Oxygen ANN prediction failed."}


def combine_stage1(cnn_is_positive, cnn_confidence, blood_result, oxygen_result):
    components = [{
        "name": "X-ray CNN",
        "available": True,
        "is_positive": cnn_is_positive,
        "result": "Positive" if cnn_is_positive else "Normal",
        "detail": f"{cnn_confidence:.1f}% confidence",
    }]

    if blood_result.get("available"):
        components.append({
            "name": "Blood ANN",
            "available": True,
            "is_positive": blood_result["is_positive"],
            "result": "Positive" if blood_result["is_positive"] else "Normal",
            "detail": f"{blood_result['prob'] * 100:.1f}% probability (partial profile)",
        })
    else:
        components.append({
            "name": "Blood ANN", "available": False, "is_positive": None,
            "result": "Not assessed", "detail": blood_result.get("reason", ""),
        })

    if oxygen_result.get("available"):
        oxygen_positive = bool(oxygen_result["is_positive"])

        # For display in Stage 1, map any pneumonia-leaning to "Positive"
        oxygen_display_label = oxygen_result["class_label"]
        if "Pneumonia-leaning" in oxygen_display_label:
            oxygen_display_label = "Positive"

        components.append({
            "name": "Oxygen ANN",
            "available": True,
            "is_positive": oxygen_positive,
            "result": oxygen_display_label,
            "detail": f"{oxygen_result['confidence']:.1f}% confidence",
        })
    else:
        components.append({
            "name": "Oxygen ANN", "available": False, "is_positive": None,
            "result": "Not assessed", "detail": oxygen_result.get("reason", ""),
        })

    voting = [c for c in components if c["available"]]
    votes_positive = sum(1 for c in voting if c["is_positive"])
    votes_total = len(voting)

    is_positive = votes_positive > votes_total / 2

    return {
        "is_positive": is_positive,
        "label": "PNEUMONIA DETECTED" if is_positive else "NORMAL",
        "votes_positive": votes_positive,
        "votes_total": votes_total,
        "components": components,
    }


# =========================
# STAGE 2: CAP SEVERITY (NSCAP / SCAP)
# =========================
SEVERITY_INFO = {
    "NSCAP": {
        "full_name": "Non-Severe Community-Acquired Pneumonia",
        "description": (
            "The combined signals (CRP, X-ray involvement extent, and vitals/labs, "
            "whichever were available) are consistent with a milder overall picture. "
            "Non-severe CAP is typically manageable with standard outpatient "
            "or general-ward care, though clinical correlation is still required."
        ),
    },
    "SCAP": {
        "full_name": "Severe Community-Acquired Pneumonia",
        "description": (
            "The combined signals (CRP, X-ray involvement extent, and vitals/labs, "
            "whichever were available) are consistent with a more severe overall picture. "
            "Severe CAP is associated with a higher-risk clinical course and "
            "often warrants closer monitoring or escalated (e.g. ICU-level) care."
        ),
    },
}


SEVERITY_MODALITY_WEIGHTS = {
    "crp_model": 0.2,
    "xray_extent": 0.5,
    "vitals": 0.3,
}

VITALS_SEVERITY_THRESHOLDS = {
    "spo2":        lambda v: v < 92,
    "pulse_rate":  lambda v: v > 125,
    "wbc":         lambda v: v < 4000 or v > 20000,
    "platelet":    lambda v: v < 100,
    "temperature": lambda v: v < 96.8 or v > 104,
}


def heatmap_hot_fraction(heatmap):
    h = cv2.resize(heatmap.astype("float32"), (IMG_SIZE, IMG_SIZE), interpolation=cv2.INTER_CUBIC)
    if float(h.max()) <= 1e-6:
        return 0.0
    threshold = 0.6 * h.max()
    return float((h >= threshold).sum()) / h.size


def vitals_severity_score(lab_rows):
    by_label = {row["label"]: row for row in lab_rows}
    label_for_key = {
        "spo2": "SpO2", "pulse_rate": "Pulse Rate", "wbc": "WBC",
        "platelet": "Platelets", "temperature": "Temperature",
    }

    flagged = 0
    considered = 0
    for key, check in VITALS_SEVERITY_THRESHOLDS.items():
        row = by_label.get(label_for_key[key])
        if row is None or row["flag"] == "N/A":
            continue
        try:
            value = float(row["value"].rstrip(" *"))
        except (ValueError, TypeError):
            continue
        considered += 1
        if check(value):
            flagged += 1

    if considered == 0:
        return 0.0, 0
    return flagged / considered, considered


def predict_severity(crp_raw, extent_fraction=None, lab_rows=None):
    components = []
    crp_val = None

    if crp_model is not None and crp_scaler is not None:
        crp_str = "" if crp_raw is None else str(crp_raw).strip()
        if crp_str != "":
            try:
                crp_candidate = float(crp_str)
            except (ValueError, TypeError):
                crp_candidate = None
            if crp_candidate is not None and crp_candidate >= 0:
                try:
                    X = np.array([[crp_candidate]], dtype="float32")
                    X_scaled = crp_scaler.transform(X)
                    prob_scap = float(crp_model.predict(X_scaled, verbose=0).squeeze())
                    crp_val = crp_candidate
                    components.append(("CRP severity model", prob_scap, SEVERITY_MODALITY_WEIGHTS["crp_model"]))
                except Exception as e:
                    print("CRP severity prediction error:", e)

    if extent_fraction is not None:
        extent_component = min(1.0, extent_fraction / 0.30)
        components.append(("X-ray involvement extent", extent_component, SEVERITY_MODALITY_WEIGHTS["xray_extent"]))

    if lab_rows is not None:
        vitals_component, considered = vitals_severity_score(lab_rows)
        if considered > 0:
            components.append(("Vitals severity indicators", vitals_component, SEVERITY_MODALITY_WEIGHTS["vitals"]))

    if not components:
        return {"available": False, "reason": "No CRP, X-ray extent, or vitals signal was available to stage severity."}

    total_weight = sum(w for _, _, w in components)
    composite = sum(value * w for _, value, w in components) / total_weight

    is_severe = composite >= 0.5
    label = "SCAP" if is_severe else "NSCAP"
    confidence = composite * 100 if is_severe else (1 - composite) * 100
    meta = SEVERITY_INFO[label]

    breakdown = [
        {
            "name": name,
            "weight_pct": round(100 * w / total_weight, 1),
            "value_pct": round(value * 100, 1),
        }
        for name, value, w in components
    ]

    return {
        "available": True,
        "label": label,
        "confidence": confidence,
        "crp_value": crp_val,
        "full_name": meta["full_name"],
        "description": meta["description"],
        "breakdown": breakdown,
    }


def gradcam(model, img_array, layer_name, layer_owner):
    if model is None or layer_name is None:
        return np.zeros((IMG_SIZE, IMG_SIZE), dtype="float32")

    try:
        if not getattr(model, "inputs", None):
            _ = model(img_array)

        grad_model = tf.keras.models.Model(
            inputs=model.inputs,
            outputs=[layer_owner.get_layer(layer_name).output, model.output]
        )

        with tf.GradientTape() as tape:
            conv_out, preds = grad_model(img_array)
            loss = tf.reduce_max(preds, axis=1)

        grads = tape.gradient(loss, conv_out)

        if grads is None:
            return np.zeros((IMG_SIZE, IMG_SIZE), dtype="float32")

        pooled = tf.reduce_mean(grads, axis=(0, 1, 2))

        conv_out = conv_out[0]
        heatmap = conv_out @ pooled[..., tf.newaxis]
        heatmap = tf.squeeze(heatmap)

        heatmap = tf.maximum(heatmap, 0)
        heatmap = heatmap / (tf.reduce_max(heatmap) + 1e-8)

        return heatmap.numpy()

    except Exception as e:
        print("Grad-CAM error:", e)
        return np.zeros((IMG_SIZE, IMG_SIZE), dtype="float32")


def make_overlay(img, heatmap):
    heatmap = cv2.resize(heatmap, (IMG_SIZE, IMG_SIZE))
    heatmap = np.uint8(255 * heatmap)
    heatmap = cv2.applyColorMap(heatmap, cv2.COLORMAP_JET)

    img = cv2.resize(img, (IMG_SIZE, IMG_SIZE))
    return cv2.addWeighted(img, 0.6, heatmap, 0.4, 0)


def get_bbox_from_heatmap(heatmap, threshold_ratio=0.6, min_area_ratio=0.008):
    h = cv2.resize(heatmap.astype("float32"), (IMG_SIZE, IMG_SIZE))

    if float(h.max()) <= 1e-6:
        return None

    thresh_val = threshold_ratio * h.max()
    mask = (h >= thresh_val).astype("uint8") * 255

    kernel = np.ones((5, 5), np.uint8)
    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)
    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)

    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not contours:
        return None

    largest = max(contours, key=cv2.contourArea)
    min_area = min_area_ratio * IMG_SIZE * IMG_SIZE
    if cv2.contourArea(largest) < min_area:
        return None

    x, y, w, box_h = cv2.boundingRect(largest)

    pad = 4
    x1 = max(0, x - pad)
    y1 = max(0, y - pad)
    x2 = min(IMG_SIZE, x + w + pad)
    y2 = min(IMG_SIZE, y + box_h + pad)

    return (x1, y1, x2, y2)


def draw_bbox(img, bbox, color=(0, 255, 255), thickness=2):
    out = img.copy()
    if bbox is not None:
        x1, y1, x2, y2 = bbox
        cv2.rectangle(out, (x1, y1), (x2, y2), color, thickness)
    return out


def _add_caption(image, text):
    bar_h = 40
    canvas = np.zeros((image.shape[0] + bar_h, image.shape[1], 3), dtype=np.uint8)
    canvas[bar_h:, :, :] = image
    cv2.putText(
        canvas, text, (10, 27),
        cv2.FONT_HERSHEY_SIMPLEX, 0.65, (255, 255, 255), 2, cv2.LINE_AA
    )
    return canvas


def make_comparison_image(img, heatmap, bbox):
    img_r = cv2.resize(img, (IMG_SIZE, IMG_SIZE))
    overlay = make_overlay(img, heatmap)

    img_boxed = draw_bbox(img_r, bbox)
    overlay_boxed = draw_bbox(overlay, bbox)

    left = _add_caption(img_boxed, "Original Image")
    right = _add_caption(overlay_boxed, "Image + Grad-CAM")

    gap = np.zeros((left.shape[0], 10, 3), dtype=np.uint8)
    combined = np.hstack([left, gap, right])
    return combined


def interpret_heatmap(heatmap, is_positive, bbox=None):
    try:
        h = cv2.resize(heatmap.astype("float32"), (IMG_SIZE, IMG_SIZE), interpolation=cv2.INTER_CUBIC)

        if float(h.max()) <= 1e-6:
            return {
                "intensity": "Not available",
                "location": "No focal region detected",
                "note": "Grad-CAM could not generate a reliable attention map for this image."
            }

        threshold = 0.6 * h.max()
        hot_fraction = float((h >= threshold).sum()) / h.size

        if hot_fraction < 0.06:
            intensity = "High & focal"
            intensity_note = "the model's attention is tightly concentrated in a small region"
        elif hot_fraction < 0.18:
            intensity = "Moderate"
            intensity_note = "the model's attention is moderately concentrated"
        else:
            intensity = "Low & diffuse"
            intensity_note = "the model's attention is spread across a broad area"

        if not is_positive:
            return {
                "intensity": "Normal",
                "location": "No significant abnormal focus",
                "note": (
                    "The Grad-CAM visualization shows where the AI model focused while "
                    "confirming a normal chest X-ray. Highlighted regions represent "
                    "model attention only and should not be interpreted as disease."
                )
            }

        def quadrant_for_point(px, py):
            half = "upper" if py < h.shape[0] / 2 else "lower"
            side = "right" if px < h.shape[1] / 2 else "left"
            return f"{half} zone of the {side} lung field"

        if bbox is not None:
            x1, y1, x2, y2 = bbox
            cx, cy = (x1 + x2) / 2, (y1 + y2) / 2
            location = quadrant_for_point(cx, cy)
        else:
            py, px = np.unravel_index(np.argmax(h), h.shape)
            location = quadrant_for_point(px, py)

        if is_positive:
            note = (
                f"{intensity_note.capitalize()}, concentrated mainly in the {location}. "
                "This is the region that contributed most to the pneumonia prediction."
            )
        else:
            note = (
                f"{intensity_note.capitalize()}, with the {location} showing the most (though still low) "
                "activation. No strong focal abnormality pattern was detected."
            )

        return {
            "intensity": intensity,
            "location": location.capitalize(),
            "note": note
        }

    except Exception:
        return {
            "intensity": "Not available",
            "location": "Not available",
            "note": "Heatmap interpretation could not be generated for this image."
        }


def save_patient(full_name, age, gender):
    conn = get_connection()
    try:
        cursor = conn.cursor()
        try:
            cursor.execute(
                "INSERT INTO patients (full_name, age, gender) VALUES (%s, %s, %s)",
                (full_name, age, gender)
            )
            conn.commit()
            return cursor.lastrowid
        finally:
            cursor.close()
    finally:
        conn.close()


def save_report(patient_id, report_code, prediction, confidence, image_name, pdf_path, severity_label=None):
    conn = get_connection()
    try:
        cursor = conn.cursor()
        try:
            cursor.execute(
                """INSERT INTO diagnosis_reports
                   (patient_id, report_code, image_name, final_diagnosis, confidence, pdf_path, severity)
                   VALUES (%s, %s, %s, %s, %s, %s, %s)""",
                (patient_id, report_code, image_name, prediction, confidence, pdf_path, severity_label)
            )
            conn.commit()
        finally:
            cursor.close()
    finally:
        conn.close()


# =========================
# AUTO-FILL: remember patient data by X-ray fingerprint
# =========================
AUTOFILL_FIELDS = ["patient_name", "age", "gender", "wbc", "rbc", "platelet",
                   "hb", "temperature", "spo2", "pulse_rate", "crp"]
_AUTOFILL_COLS = ", ".join(AUTOFILL_FIELDS)


def image_hash(file_bytes):
    """Unique fingerprint of the uploaded X-ray file."""
    return hashlib.sha256(file_bytes).hexdigest()


def save_autofill_record(file_bytes, data):
    """Store (or update) one patient's values, keyed by X-ray fingerprint."""
    placeholders = ", ".join(["%s"] * (len(AUTOFILL_FIELDS) + 1))
    updates = ", ".join(f"{f}=VALUES({f})" for f in AUTOFILL_FIELDS)
    values = [image_hash(file_bytes)] + [str(data.get(f, "") or "") for f in AUTOFILL_FIELDS]

    conn = get_connection()
    try:
        cursor = conn.cursor()
        try:
            cursor.execute(
                f"INSERT INTO stored_patients (image_hash, {_AUTOFILL_COLS}) VALUES ({placeholders}) "
                f"ON DUPLICATE KEY UPDATE {updates}",
                values,
            )
            conn.commit()
        finally:
            cursor.close()
    finally:
        conn.close()


@app.post("/lookup")
async def lookup(file: UploadFile = File(...)):
    """Called by the browser as soon as an X-ray is dropped on the form."""
    contents = await file.read()
    try:
        conn = get_connection()
        try:
            cursor = conn.cursor(dictionary=True)
            try:
                cursor.execute(
                    f"SELECT {_AUTOFILL_COLS} FROM stored_patients WHERE image_hash = %s",
                    (image_hash(contents),),
                )
                row = cursor.fetchone()
            finally:
                cursor.close()
        finally:
            conn.close()
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
    return {"found": row is not None, "data": row}


