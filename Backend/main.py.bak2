"""


def build_glossary_html():
    nscap = SEVERITY_INFO["NSCAP"]
    scap = SEVERITY_INFO["SCAP"]
    return f"""
      <div class="glossary-card">
        <h4>About CAP Severity Staging (NSCAP / SCAP)</h4>
        <p style="font-size:12.5px;color:#64748b;margin:0 0 12px 0;line-height:1.6;">
          Staging is a weighted composite of up to three signals when a case is positive for
          pneumonia: the CRP severity model, how much of the lung field Grad-CAM flagged as
          involved on the X-ray, and how many entered vitals/labs fall outside a
          severity-relevant range. It is not based on CRP alone.
        </p>
        <dl>
          <dt>NSCAP &mdash; {nscap['full_name']}</dt>
          <dd>{nscap['description']}</dd>
          <dt>SCAP &mdash; {scap['full_name']}</dt>
          <dd>{scap['description']}</dd>
        </dl>
      </div>"""


def build_stage1_html(stage1_result):
    rows = ""
    for c in stage1_result["components"]:
        if not c["available"]:
            pill_class, pill_text = "na", "Not assessed"
        elif c["is_positive"]:
            pill_class, pill_text = "pos", c["result"]
        else:
            pill_class, pill_text = "neg", c["result"]
        rows += f"""
        <div class="stage1-row">
          <span class="stage1-name">{html.escape(c['name'])}</span>
          <span class="stage1-pill {pill_class}">{html.escape(pill_text)}</span>
          <span class="stage1-detail">{html.escape(c['detail'])}</span>
        </div>"""

    return f"""
      <div class="stage1-card">
        <h4>Stage 1 &middot; Multimodal Screening</h4>
        <div class="stage1-vote-line">
          {stage1_result['votes_positive']} of {stage1_result['votes_total']} available signal(s) voted Positive &middot;
          final call by majority vote: <strong>{stage1_result['label']}</strong>
        </div>
        {rows}
      </div>"""


def build_crp_high_normal_note_html(crp_row, is_positive):
    if is_positive or not crp_row or crp_row.get("flag") != "High":
        return ""
    return f"""
      <div class="info-note">
        <h4>⚠ Elevated CRP Despite Normal X-Ray</h4>
        <p>
          The chest X-ray was read as NORMAL by the AI model, but the entered CRP
          ({crp_row['value']} {crp_row['unit']}) is above the standard reference range.
          CRP is a general marker of inflammation in the body and can be elevated for many
          reasons unrelated to the lungs (other infections, injury, autoimmune conditions,
          etc.), so this does not itself indicate pneumonia and NSCAP/SCAP staging is not
          run on a NORMAL result. Please correlate with clinical findings and consider
          further evaluation if elevated CRP is otherwise unexplained.
        </p>
      </div>"""


@app.post("/predict", response_class=HTMLResponse)
async def predict(
    patient_name: str = Form(...),
    age: str = Form(...),
    gender: str = Form(...),
    wbc: str = Form(""),
    rbc: str = Form(""),
    platelet: str = Form(""),
    hb: str = Form(""),
    temperature: str = Form(""),
    spo2: str = Form(""),
    pulse_rate: str = Form(""),
    crp: str = Form(""),
    save_for_autofill: str = Form(""),
    file: UploadFile = File(...)
):
    try:
        if model is None:
            return HTMLResponse("<h2>Model not loaded</h2>")

        cleanup_old_files("static")
        cleanup_old_files("reports")
        cleanup_stale_pdf_store_entries()

        patient_name_safe = html.escape(patient_name)
        age_safe = html.escape(age)
        gender_safe = html.escape(gender)

        contents = await file.read()

        # AUTO-FILL: remember this patient if the checkbox was ticked
        if save_for_autofill:
            try:
                save_autofill_record(contents, {
                    "patient_name": patient_name, "age": age, "gender": gender,
                    "wbc": wbc, "rbc": rbc, "platelet": platelet, "hb": hb,
                    "temperature": temperature, "spo2": spo2,
                    "pulse_rate": pulse_rate, "crp": crp,
                })
            except Exception as autofill_err:
                print("Autofill save error:", autofill_err)

        img, img_array = preprocess(contents)

        pred = model.predict(img_array)
        raw_prob = float(pred.squeeze())

        pneumonia_prob = raw_prob if POSITIVE_CLASS_IS_PNEUMONIA_WHEN_PROB_HIGH else (1 - raw_prob)
        print(f"[predict] raw_model_output={raw_prob:.4f}  pneumonia_prob={pneumonia_prob:.4f}  "
              f"polarity_flag={POSITIVE_CLASS_IS_PNEUMONIA_WHEN_PROB_HIGH}")

        cnn_is_positive = pneumonia_prob > 0.5
        confidence = pneumonia_prob * 100 if cnn_is_positive else (1 - pneumonia_prob) * 100

        blood_result = predict_blood_ann(age, hb, platelet, wbc, rbc)
        oxygen_result = predict_oxygen_ann(spo2, pulse_rate, temperature)
        stage1_result = combine_stage1(cnn_is_positive, confidence, blood_result, oxygen_result)

        is_positive = stage1_result["is_positive"]
        label = stage1_result["label"]
        result_class = "positive" if is_positive else "negative"
        stage1_html = build_stage1_html(stage1_result)

        last_conv, layer_owner = get_last_conv(model)
        heatmap = gradcam(model, img_array, last_conv, layer_owner)

        bbox = get_bbox_from_heatmap(heatmap) if is_positive else None
        region_localized = bbox is not None

        heatmap_info = interpret_heatmap(heatmap, is_positive, bbox)

        if is_positive:
            comparison_img = make_comparison_image(img, heatmap, bbox)
        else:
            img_r = cv2.resize(img, (IMG_SIZE, IMG_SIZE))
            comparison_img = _add_caption(img_r, "Original Image")

        img_name = f"{uuid.uuid4().hex}.jpg"
        cv2.imwrite(f"static/{img_name}", comparison_img)

        report_id = uuid.uuid4().hex[:10].upper()
        timestamp = datetime.now().strftime("%d %b %Y, %I:%M %p")

        vitals = {
            "wbc": wbc, "rbc": rbc, "platelet": platelet, "hb": hb,
            "temperature": temperature, "spo2": spo2, "pulse_rate": pulse_rate,
            "crp": crp
        }
        lab_rows = evaluate_all_vitals(vitals)

        extent_fraction = heatmap_hot_fraction(heatmap) if is_positive else None
        severity_info = predict_severity(crp, extent_fraction, lab_rows) if is_positive else None

        lab_rows_html = "".join(
            f"""<tr>
                <td>{r['label']}</td>
                <td><strong>{r['value']}</strong></td>
                <td class="range-col">{r['unit']}</td>
                <td class="range-col">{r['range']}</td>
                <td><span class="flag-pill {r['flag'].replace('/', '')}">{r['flag']}</span></td>
            </tr>"""
            for r in lab_rows
        )
        unit_warnings = [r for r in lab_rows if r.get("unit_warning")]
        unit_warning_html = ""
        if unit_warnings:
            items = "".join(
                f"<li>{r['label']}: value {r['unit_warning']}</li>" for r in unit_warnings
            )
            unit_warning_html = f"""
            <p style="font-size:12px;color:#b45309;margin-top:-18px;margin-bottom:28px;">
              ⚠ Some entered values looked like they were in the wrong unit and were
              auto-converted before flagging: <ul style="margin:4px 0 0 18px;padding:0;">{items}</ul>
              Please double-check the original entry.
            </p>"""

        crp_row = next((r for r in lab_rows if r["label"] == "CRP"), None)

        severity_html = ""
        if is_positive:
            if severity_info and severity_info["available"]:
                sev_class = "scap" if severity_info["label"] == "SCAP" else "nscap"
                crp_badge_html = (
                    f'<span class="severity-crp-badge">CRP entered: {severity_info["crp_value"]:g} mg/L</span>'
                    if severity_info.get("crp_value") is not None else ""
                )
                breakdown_rows = "".join(
                    f"""<div class="sev-breakdown-row">
                        <span class="sev-breakdown-name">{html.escape(b['name'])}</span>
                        <span class="sev-breakdown-bar"><span style="width:{b['value_pct']:.0f}%;"></span></span>
                        <span class="sev-breakdown-val">{b['value_pct']:.0f}% &middot; weight {b['weight_pct']:.0f}%</span>
                    </div>"""
                    for b in severity_info.get("breakdown", [])
                )
                severity_html = f"""
      <div class="severity-banner {sev_class}">
        <div class="sev-top">
          <h3>CAP Severity: {severity_info['label']}</h3>
          <span class="sev-conf">Composite Confidence: {severity_info['confidence']:.2f}%</span>
        </div>
        <div class="sev-full">{severity_info['full_name']}</div>
        <div class="sev-desc">{severity_info['description']}</div>
        <div class="sev-breakdown">
          <div class="sev-breakdown-label">Based on {len(severity_info.get('breakdown', []))} combined signal(s), not CRP alone:</div>
          {breakdown_rows}
        </div>
        {crp_badge_html}
      </div>"""
            else:
                reason = html.escape(severity_info["reason"]) if severity_info else "Severity model unavailable."
                severity_html = f"""
      <div class="severity-banner unavailable">
        <div class="sev-top"><h3>CAP Severity: Not Assessed</h3></div>
        <div class="sev-desc">{reason}</div>
      </div>"""

        crp_high_normal_note_html = build_crp_high_normal_note_html(crp_row, is_positive)

        glossary_html = build_glossary_html()

        image_caption = (
            "Yellow box marks the localized infected/abnormal region • Red/Yellow heatmap shows where the model focused."
            if is_positive
            else "Original Chest X-ray (Grad-CAM hidden because no abnormal region was detected)."
        )

        pdf_path = build_pdf_report(
            report_id=report_id,
            timestamp=timestamp,
            patient_name=patient_name,
            age=age,
            gender=gender,
            label=label,
            confidence=confidence,
            is_positive=is_positive,
            image_path=f"static/{img_name}",
            image_shape=comparison_img.shape,
            vitals=vitals,
            lab_rows=lab_rows,
            heatmap_info=heatmap_info,
            region_localized=region_localized,
            severity_info=severity_info,
            crp_row=crp_row,
            stage1_result=stage1_result
        )
        PDF_STORE[report_id] = pdf_path

        try:
            age_for_db = int(age)
        except (TypeError, ValueError):
            age_for_db = None

        try:
            patient_id = save_patient(patient_name, age_for_db, gender)
            save_report(
                patient_id=patient_id,
                report_code=report_id,
                prediction=label,
                confidence=round(confidence, 2),
                image_name=img_name,
                pdf_path=pdf_path,
                severity_label=(severity_info["label"] if severity_info and severity_info["available"] else None)
            )
        except Exception as db_err:
            print("DB save error:", db_err)

        return f"""
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Report Result &middot; Pneumonia Detection System</title>
<style>{BASE_CSS}</style>
</head>
<body>

<div class="shell">

  <div class="brand">
    <div class="logo">🫁</div>
    <h1>Pneumonia Detection System
      <span>Analysis Result &middot; Report #{report_id}</span>
    </h1>
  </div>

  <div class="card">
    <div class="card-pad">

      <div class="result-banner {result_class}">
        <h2>{label}</h2>
        <div class="conf">Model Confidence: {confidence:.2f}%</div>
        <div class="confidence-bar">
          <div class="confidence-fill {result_class}" style="width:{confidence:.1f}%;"></div>
        </div>
      </div>
      {stage1_html}
      {severity_html}
      {crp_high_normal_note_html}

      <div class="info-grid">
        <div class="info-tile"><div class="k">Patient</div><div class="v">{patient_name_safe}</div></div>
        <div class="info-tile"><div class="k">Age / Gender</div><div class="v">{age_safe} / {gender_safe}</div></div>
        <div class="info-tile"><div class="k">Scan Date</div><div class="v">{timestamp}</div></div>
      </div>

      <div class="lab-card">
        <table class="lab-table">
          <thead>
            <tr>
              <th>Test</th>
              <th>Result</th>
              <th>Unit</th>
              <th>Normal Range</th>
              <th>Flag</th>
            </tr>
          </thead>
          <tbody>
            {lab_rows_html}
          </tbody>
        </table>
      </div>
      {unit_warning_html}

      <div class="image-panel">
        <img src="/static/{img_name}" alt="X-Ray with Grad-CAM heatmap and infected region box">
        <div class="cap">{image_caption}</div>
      </div>

      <div class="interp-card">
        <div class="interp-grid">
          <div class="interp-tile"><div class="k">Attention Intensity</div><div class="v">{heatmap_info['intensity']}</div></div>
          <div class="interp-tile"><div class="k">Region of Focus</div><div class="v">{heatmap_info['location']}</div></div>
        </div>
        <div class="interp-note">{heatmap_info['note']}</div>
      </div>

      {glossary_html}

      <div class="actions">
        <a href="/download?report_id={report_id}" class="btn">⬇ Download PDF Report</a>
        <a href="/" class="btn btn-outline"> Go to Home</a>
      </div>

      <p class="disclaimer">
        This report is generated by an AI-assisted screening tool and is intended to support,
        not replace, evaluation by a qualified radiologist or physician. Confidence scores reflect
        model certainty, not clinical certainty. CAP severity staging (NSCAP/SCAP) is based on a
        composite of CRP, X-ray involvement extent, and entered vitals/labs, and does not
        replace a full clinical severity assessment.
      </p>

    </div>
  </div>

</div>

</body>
</html>
"""

    except Exception:
        traceback.print_exc()
        return HTMLResponse(
            "<h2>Something went wrong while generating the report.</h2>"
            "<p>Please try again. If the problem persists, contact support.</p>",
            status_code=500
        )


def build_pdf_report(report_id, timestamp, patient_name, age, gender,
                     label, confidence, is_positive, image_path, image_shape,
                     vitals, lab_rows, heatmap_info, region_localized,
                     severity_info=None, crp_row=None, stage1_result=None):

    pdf_path = f"reports/report_{report_id}.pdf"

    doc = SimpleDocTemplate(
        pdf_path, pagesize=A4,
        topMargin=18 * mm, bottomMargin=18 * mm,
        leftMargin=18 * mm, rightMargin=18 * mm
    )

    styles = getSampleStyleSheet()

    title_style = ParagraphStyle(
        "TitleStyle", parent=styles["Title"],
        fontSize=20, textColor=colors.HexColor("#0f172a"),
        alignment=TA_LEFT, spaceAfter=2
    )
    sub_style = ParagraphStyle(
        "SubStyle", parent=styles["Normal"],
        fontSize=10, textColor=colors.HexColor("#64748b"),
        alignment=TA_LEFT
    )
    section_style = ParagraphStyle(
        "SectionStyle", parent=styles["Heading2"],
        fontSize=12.5, textColor=colors.HexColor("#0ea5e9"),
        spaceBefore=14, spaceAfter=8
    )
    normal_style = ParagraphStyle(
        "NormalStyle", parent=styles["Normal"],
        fontSize=10.5, leading=15
    )
    result_style = ParagraphStyle(
        "ResultStyle", parent=styles["Normal"],
        fontSize=16, leading=20, alignment=TA_CENTER,
        textColor=colors.HexColor("#b91c1c") if is_positive else colors.HexColor("#15803d"),
        fontName="Helvetica-Bold"
    )
    conf_style = ParagraphStyle(
        "ConfStyle", parent=styles["Normal"],
        fontSize=10.5, alignment=TA_CENTER,
        textColor=colors.HexColor("#475569")
    )
    disclaimer_style = ParagraphStyle(
        "DisclaimerStyle", parent=styles["Normal"],
        fontSize=8, textColor=colors.HexColor("#94a3b8"),
        alignment=TA_CENTER, leading=11
    )

    content = []

    header_table = Table(
        [[Paragraph("Pneumonia Detection System", title_style), Paragraph(f"Report ID: {report_id}<br/>{timestamp}", sub_style)]],
        colWidths=[110 * mm, 60 * mm]
    )
    header_table.setStyle(TableStyle([
        ("VALIGN", (0, 0), (-1, -1), "TOP"),
        ("ALIGN", (1, 0), (1, 0), "RIGHT"),
    ]))
    content.append(header_table)
    content.append(Paragraph("AI-Assisted Chest X-Ray Screening Report", sub_style))
    content.append(Spacer(1, 6))
    content.append(HRFlowable(width="100%", thickness=1.2, color=colors.HexColor("#0ea5e9")))
    content.append(Spacer(1, 14))

    content.append(Paragraph("PATIENT INFORMATION", section_style))
    patient_table = Table(
        [
            ["Name", patient_name, "Age", age],
            ["Gender", gender, "Report Date", timestamp],
        ],
        colWidths=[28 * mm, 57 * mm, 28 * mm, 57 * mm]
    )
    patient_table.setStyle(TableStyle([
        ("FONTNAME", (0, 0), (0, -1), "Helvetica-Bold"),
        ("FONTNAME", (2, 0), (2, -1), "Helvetica-Bold"),
        ("FONTSIZE", (0, 0), (-1, -1), 10),
        ("TEXTCOLOR", (0, 0), (0, -1), colors.HexColor("#64748b")),
        ("TEXTCOLOR", (2, 0), (2, -1), colors.HexColor("#64748b")),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 8),
        ("TOPPADDING", (0, 0), (-1, -1), 8),
        ("LINEBELOW", (0, 0), (-1, 0), 0.5, colors.HexColor("#e2e8f0")),
        ("BACKGROUND", (0, 0), (-1, -1), colors.HexColor("#f8fafc")),
        ("BOX", (0, 0), (-1, -1), 0.5, colors.HexColor("#e2e8f0")),
        ("LEFTPADDING", (0, 0), (-1, -1), 10),
    ]))
    content.append(patient_table)
    content.append(Spacer(1, 10))

    content.append(Paragraph("VITALS &amp; LAB VALUES", section_style))

    flag_colors = {
        "Normal": colors.HexColor("#15803d"),
        "Low": colors.HexColor("#b45309"),
        "High": colors.HexColor("#b91c1c"),
        "N/A": colors.HexColor("#94a3b8"),
    }

    lab_header_style = ParagraphStyle(
        "LabHeaderStyle", parent=styles["Normal"],
        fontSize=9, textColor=colors.white, fontName="Helvetica-Bold"
    )
    lab_cell_style = ParagraphStyle(
        "LabCellStyle", parent=styles["Normal"],
        fontSize=9.5, textColor=colors.HexColor("#0f172a")
    )

    lab_table_data = [[
        Paragraph("TEST", lab_header_style),
        Paragraph("RESULT", lab_header_style),
        Paragraph("UNIT", lab_header_style),
        Paragraph("NORMAL RANGE", lab_header_style),
        Paragraph("FLAG", lab_header_style),
    ]]

    for i, row in enumerate(lab_rows):
        flag_style = ParagraphStyle(
            f"FlagStyle{i}", parent=styles["Normal"],
            fontSize=9.5, fontName="Helvetica-Bold",
            textColor=flag_colors.get(row["flag"], colors.HexColor("#0f172a"))
        )
        lab_table_data.append([
            Paragraph(row["label"], lab_cell_style),
            Paragraph(row["value"], lab_cell_style),
            Paragraph(row["unit"], lab_cell_style),
            Paragraph(row["range"], lab_cell_style),
            Paragraph(row["flag"], flag_style),
        ])

    lab_table = Table(
        lab_table_data,
        colWidths=[38 * mm, 28 * mm, 28 * mm, 40 * mm, 36 * mm]
    )

    lab_style_cmds = [
        ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#0ea5e9")),
        ("TOPPADDING", (0, 0), (-1, 0), 8),
        ("BOTTOMPADDING", (0, 0), (-1, 0), 8),
        ("TOPPADDING", (0, 1), (-1, -1), 7),
        ("BOTTOMPADDING", (0, 1), (-1, -1), 7),
        ("LEFTPADDING", (0, 0), (-1, -1), 8),
        ("BOX", (0, 0), (-1, -1), 0.5, colors.HexColor("#e2e8f0")),
        ("LINEBELOW", (0, 0), (-1, -2), 0.5, colors.HexColor("#e2e8f0")),
        ("ROWBACKGROUNDS", (0, 1), (-1, -1), [colors.white, colors.HexColor("#f8fafc")]),
    ]
    lab_table.setStyle(TableStyle(lab_style_cmds))
    content.append(lab_table)
    content.append(Spacer(1, 4))
    content.append(Paragraph(
        "Reference ranges shown are standard adult values and may vary slightly by laboratory and patient context.",
        ParagraphStyle("RangeNote", parent=styles["Normal"], fontSize=7.5,
                        textColor=colors.HexColor("#94a3b8"))
    ))
    content.append(Spacer(1, 10))

    if stage1_result is not None:
        content.append(Paragraph("STAGE 1 &middot; MULTIMODAL SCREENING", section_style))

        stage1_label_style = ParagraphStyle(
            "Stage1LabelStyle", parent=styles["Normal"],
            fontSize=9.5, leading=14, textColor=colors.HexColor("#334155")
        )
        stage1_row_style = ParagraphStyle(
            "Stage1RowStyle", parent=styles["Normal"],
            fontSize=9, leading=13, textColor=colors.HexColor("#0f172a")
        )

        stage1_intro = (
            f"{stage1_result['votes_positive']} of {stage1_result['votes_total']} available signal(s) "
            f"voted Positive &mdash; final call by majority vote: <b>{stage1_result['label']}</b>"
        )

        stage1_table_data = [[
            Paragraph("SIGNAL", lab_header_style),
            Paragraph("RESULT", lab_header_style),
            Paragraph("DETAIL", lab_header_style),
        ]]
        for c in stage1_result["components"]:
            if not c["available"]:
                result_color = colors.HexColor("#94a3b8")
            elif c["is_positive"]:
                result_color = colors.HexColor("#b91c1c")
            else:
                result_color = colors.HexColor("#15803d")
            result_style_row = ParagraphStyle(
                f"Stage1ResultStyle{c['name']}", parent=styles["Normal"],
                fontSize=9, fontName="Helvetica-Bold", textColor=result_color
            )
            stage1_table_data.append([
                Paragraph(c["name"], stage1_row_style),
                Paragraph(c["result"], result_style_row),
                Paragraph(c["detail"] or "-", stage1_row_style),
            ])

        stage1_table = Table(stage1_table_data, colWidths=[40 * mm, 45 * mm, 85 * mm])
        stage1_table.setStyle(TableStyle([
            ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#0ea5e9")),
            ("TOPPADDING", (0, 0), (-1, -1), 7),
            ("BOTTOMPADDING", (0, 0), (-1, -1), 7),
            ("LEFTPADDING", (0, 0), (-1, -1), 8),
            ("BOX", (0, 0), (-1, -1), 0.5, colors.HexColor("#e2e8f0")),
            ("LINEBELOW", (0, 0), (-1, -2), 0.5, colors.HexColor("#e2e8f0")),
            ("ROWBACKGROUNDS", (0, 1), (-1, -1), [colors.white, colors.HexColor("#f8fafc")]),
        ]))

        content.append(Paragraph(stage1_intro, stage1_label_style))
        content.append(Spacer(1, 6))
        content.append(stage1_table)
        content.append(Spacer(1, 14))

    content.append(Paragraph("AI SCREENING RESULT", section_style))

    result_box_color = colors.HexColor("#fef2f2") if is_positive else colors.HexColor("#f0fdf4")
    result_border_color = colors.HexColor("#fecaca") if is_positive else colors.HexColor("#bbf7d0")

    result_inner = Table(
        [[Paragraph(label, result_style)],
         [Paragraph(f"Model Confidence: {confidence:.2f}%", conf_style)]],
        colWidths=[170 * mm]
    )
    result_inner.setStyle(TableStyle([
        ("BACKGROUND", (0, 0), (-1, -1), result_box_color),
        ("BOX", (0, 0), (-1, -1), 1, result_border_color),
        ("TOPPADDING", (0, 0), (-1, 0), 14),
        ("BOTTOMPADDING", (0, 0), (-1, 0), 4),
        ("BOTTOMPADDING", (0, 1), (-1, 1), 14),
    ]))
    content.append(result_inner)
    content.append(Spacer(1, 14))

    if is_positive:
        content.append(Paragraph("CAP SEVERITY ASSESSMENT", section_style))

        if severity_info and severity_info["available"]:
            sev_is_severe = severity_info["label"] == "SCAP"
            sev_box_color = colors.HexColor("#fef2f2") if sev_is_severe else colors.HexColor("#fffbeb")
            sev_border_color = colors.HexColor("#fecaca") if sev_is_severe else colors.HexColor("#fde68a")
            sev_text_color = colors.HexColor("#b91c1c") if sev_is_severe else colors.HexColor("#b45309")

            sev_label_style = ParagraphStyle(
                "SevLabelStyle", parent=styles["Normal"],
                fontSize=14, leading=18, alignment=TA_CENTER,
                textColor=sev_text_color, fontName="Helvetica-Bold"
            )
            sev_full_style = ParagraphStyle(
                "SevFullStyle", parent=styles["Normal"],
                fontSize=10, alignment=TA_CENTER,
                textColor=colors.HexColor("#475569"), fontName="Helvetica-Bold"
            )
            sev_desc_style = ParagraphStyle(
                "SevDescStyle", parent=styles["Normal"],
                fontSize=9.5, alignment=TA_CENTER, leading=14,
                textColor=colors.HexColor("#334155")
            )

            breakdown = severity_info.get("breakdown", [])
            breakdown_style = ParagraphStyle(
                "SevBreakdownStyle", parent=styles["Normal"],
                fontSize=9, alignment=TA_LEFT, leading=13,
                textColor=colors.HexColor("#334155")
            )
            breakdown_lines = "<br/>".join(
                f"&bull; {html.escape(b['name'])}: {b['value_pct']:.0f}% (weight {b['weight_pct']:.0f}%)"
                for b in breakdown
            )
            crp_line = (
                f"CRP value used: {severity_info['crp_value']:g} mg/L"
                if severity_info.get("crp_value") is not None
                else "CRP not entered for this scan -- composite uses X-ray/vitals signals only"
            )

            sev_inner = Table(
                [
                    [Paragraph(f"{severity_info['label']}  \u2014  Composite Confidence: {severity_info['confidence']:.2f}%", sev_label_style)],
                    [Paragraph(severity_info["full_name"], sev_full_style)],
                    [Paragraph(severity_info["description"], sev_desc_style)],
                    [Paragraph(f"Based on {len(breakdown)} combined signal(s), not CRP alone:<br/>{breakdown_lines}", breakdown_style)],
                    [Paragraph(crp_line, conf_style)],
                ],
                colWidths=[170 * mm]
            )
            sev_inner.setStyle(TableStyle([
                ("BACKGROUND", (0, 0), (-1, -1), sev_box_color),
                ("BOX", (0, 0), (-1, -1), 1, sev_border_color),
                ("TOPPADDING", (0, 0), (-1, 0), 12),
                ("BOTTOMPADDING", (0, 0), (-1, 0), 2),
                ("TOPPADDING", (0, 1), (-1, 1), 2),
                ("BOTTOMPADDING", (0, 1), (-1, 1), 6),
                ("LEFTPADDING", (0, 2), (-1, 3), 14),
                ("RIGHTPADDING", (0, 2), (-1, 3), 14),
                ("BOTTOMPADDING", (0, 2), (-1, 2), 8),
                ("LEFTPADDING", (0, 3), (-1, 3), 14),
                ("BOTTOMPADDING", (0, 3), (-1, 3), 8),
                ("BOTTOMPADDING", (0, 4), (-1, 4), 12),
            ]))
            content.append(sev_inner)
        else:
            reason = severity_info["reason"] if severity_info else "Severity model unavailable."
            content.append(Paragraph(
                f"CAP severity could not be staged: {reason}",
                normal_style
            ))
        content.append(Spacer(1, 14))
    elif crp_row is not None and crp_row.get("flag") == "High":
        content.append(Paragraph("CAP SEVERITY ASSESSMENT", section_style))
        note_style = ParagraphStyle(
            "CrpNoteStyle", parent=styles["Normal"],
            fontSize=9.5, leading=14, textColor=colors.HexColor("#334155")
        )
        note_box = Table(
            [[Paragraph(
                f"<b>Elevated CRP Despite Normal X-Ray:</b> the chest X-ray was read as NORMAL, but the "
                f"entered CRP ({crp_row['value']} {crp_row['unit']}) is above the standard reference range. "
                f"CRP is a general inflammation marker and can be elevated for reasons unrelated to the lungs, "
                f"so NSCAP/SCAP staging is not run on a NORMAL result. Please correlate with clinical findings.",
                note_style
            )]],
            colWidths=[170 * mm]
        )
        note_box.setStyle(TableStyle([
            ("BACKGROUND", (0, 0), (-1, -1), colors.HexColor("#fffbeb")),
            ("BOX", (0, 0), (-1, -1), 1, colors.HexColor("#fde68a")),
            ("TOPPADDING", (0, 0), (-1, -1), 10),
            ("BOTTOMPADDING", (0, 0), (-1, -1), 10),
            ("LEFTPADDING", (0, 0), (-1, -1), 12),
            ("RIGHTPADDING", (0, 0), (-1, -1), 12),
        ]))
        content.append(note_box)
        content.append(Spacer(1, 14))

    xray_block = [Paragraph("X-RAY WITH GRAD-CAM HEATMAP", section_style)]
    try:
        px_h, px_w = image_shape[0], image_shape[1]
        target_w = 170 * mm
        target_h = target_w * (px_h / px_w)

        img_flowable = Image(image_path, width=target_w, height=target_h)
        img_table = Table([[img_flowable]], colWidths=[170 * mm])
        img_table.setStyle(TableStyle([
            ("ALIGN", (0, 0), (-1, -1), "CENTER"),
            ("BACKGROUND", (0, 0), (-1, -1), colors.HexColor("#0f172a")),
            ("TOPPADDING", (0, 0), (-1, -1), 8),
            ("BOTTOMPADDING", (0, 0), (-1, -1), 8),
        ]))
        xray_block.append(img_table)
        xray_block.append(Spacer(1, 4))
        caption_text = (
            "Yellow box marks the localized infected/abnormal region; red/yellow heatmap shows "
            "where the model focused most heavily in its decision."
            if region_localized else
            "Highlighted (red/yellow) regions indicate areas the model weighted most heavily in its "
            "decision. No single focal region was distinct enough to box."
        )
        xray_block.append(Paragraph(caption_text, conf_style))
        xray_block.append(Spacer(1, 8))

        interp_label_style = ParagraphStyle(
            "InterpLabelStyle", parent=styles["Normal"],
            fontSize=9, textColor=colors.HexColor("#64748b"),
            fontName="Helvetica-Bold"
        )
        interp_value_style = ParagraphStyle(
            "InterpValueStyle", parent=styles["Normal"],
            fontSize=10.5, textColor=colors.HexColor("#0f172a"),
            fontName="Helvetica-Bold"
        )
        interp_note_style = ParagraphStyle(
            "InterpNoteStyle", parent=styles["Normal"],
            fontSize=9.5, textColor=colors.HexColor("#334155"),
            leading=14
        )

        interp_table = Table(
            [
                [Paragraph("ATTENTION INTENSITY", interp_label_style),
                 Paragraph("REGION OF FOCUS", interp_label_style)],
                [Paragraph(heatmap_info["intensity"], interp_value_style),
                 Paragraph(heatmap_info["location"], interp_value_style)],
                [Paragraph(heatmap_info["note"], interp_note_style), ""],
            ],
            colWidths=[85 * mm, 85 * mm]
        )
        interp_table.setStyle(TableStyle([
            ("BACKGROUND", (0, 0), (-1, -1), colors.HexColor("#f8fafc")),
            ("BOX", (0, 0), (-1, -1), 0.5, colors.HexColor("#e2e8f0")),
            ("LINEBELOW", (0, 1), (-1, 1), 0.5, colors.HexColor("#e2e8f0")),
            ("SPAN", (0, 2), (1, 2)),
            ("TOPPADDING", (0, 0), (-1, -1), 8),
            ("BOTTOMPADDING", (0, 0), (-1, -1), 8),
            ("LEFTPADDING", (0, 0), (-1, -1), 10),
        ]))
        xray_block.append(interp_table)

    except Exception:
        xray_block.append(Paragraph("X-ray image could not be embedded.", normal_style))

    content.append(KeepTogether(xray_block))

    content.append(Spacer(1, 20))

    content.append(Paragraph("ABOUT CAP SEVERITY STAGING (NSCAP / SCAP)", section_style))
    glossary_intro_style = ParagraphStyle(
        "GlossaryIntroStyle", parent=styles["Normal"],
        fontSize=9, leading=13.5, textColor=colors.HexColor("#64748b"),
        spaceAfter=8
    )
    content.append(Paragraph(
        "Staging is a weighted composite of up to three signals when a case is positive for pneumonia: "
        "the CRP severity model, how much of the lung field Grad-CAM flagged as involved on the X-ray, "
        "and how many entered vitals/labs fall outside a severity-relevant range. It is not based on "
        "CRP alone.",
        glossary_intro_style
    ))
    glossary_term_style = ParagraphStyle(
        "GlossaryTermStyle", parent=styles["Normal"],
        fontSize=10, fontName="Helvetica-Bold", textColor=colors.HexColor("#0f172a"),
        spaceBefore=4, spaceAfter=2
    )
    glossary_desc_style = ParagraphStyle(
        "GlossaryDescStyle", parent=styles["Normal"],
        fontSize=9.5, leading=14, textColor=colors.HexColor("#334155"),
        spaceAfter=8
    )
    for key in ("NSCAP", "SCAP"):
        meta = SEVERITY_INFO[key]
        content.append(Paragraph(f"{key} &mdash; {meta['full_name']}", glossary_term_style))
        content.append(Paragraph(meta["description"], glossary_desc_style))

    content.append(Spacer(1, 12))

    sign_label_style = ParagraphStyle(
        "SignLabelStyle", parent=styles["Normal"],
        fontSize=8.5, textColor=colors.HexColor("#94a3b8")
    )
    sign_table = Table(
        [
            ["", ""],
            [Paragraph("Authorized Signatory", sign_label_style),
             Paragraph("Date", sign_label_style)],
        ],
        colWidths=[85 * mm, 85 * mm], rowHeights=[16 * mm, 5 * mm]
    )
    sign_table.setStyle(TableStyle([
        ("LINEABOVE", (0, 1), (0, 1), 0.7, colors.HexColor("#cbd5e1")),
        ("LINEABOVE", (1, 1), (1, 1), 0.7, colors.HexColor("#cbd5e1")),
        ("TOPPADDING", (0, 1), (-1, 1), 4),
    ]))
    content.append(sign_table)

    content.append(Spacer(1, 14))
    content.append(HRFlowable(width="100%", thickness=0.7, color=colors.HexColor("#e2e8f0")))
    content.append(Spacer(1, 8))
    content.append(Paragraph(
        "This report is generated by an AI-assisted screening tool (Pneumonia Detection System) and is intended to "
        "support, not replace, evaluation by a qualified radiologist or licensed physician. "
        "Confidence scores reflect model certainty based on training data and do not constitute a "
        "clinical diagnosis. CAP severity staging (NSCAP/SCAP), where shown, is a weighted composite of "
        "whichever signals were available for this case (CRP, X-ray Grad-CAM involvement extent, entered "
        "vitals/labs) and should be correlated with full clinical assessment. Please correlate "
        "with clinical findings and consult a healthcare professional for final interpretation.",
        disclaimer_style
    ))

    def add_page_footer(canvas_obj, doc_obj):
        canvas_obj.saveState()
        canvas_obj.setFont("Helvetica", 8)
        canvas_obj.setFillColor(colors.HexColor("#94a3b8"))
        footer_text = f"Pneumonia Detection System  |  Report #{report_id}  |  Page {doc_obj.page}"
        canvas_obj.drawCentredString(A4[0] / 2, 12 * mm, footer_text)
        canvas_obj.restoreState()

    doc.build(content, onFirstPage=add_page_footer, onLaterPages=add_page_footer)
    return pdf_path


@app.get("/history", response_class=HTMLResponse)
def history():
    try:
        conn = get_connection()
        try:
            cursor = conn.cursor(dictionary=True)
            try:
                cursor.execute("""
                    SELECT dr.report_id, dr.report_code, dr.final_diagnosis,
                           dr.confidence, dr.image_name, dr.created_at, dr.severity,
                           p.full_name, p.age, p.gender
                    FROM diagnosis_reports dr
                    JOIN patients p ON dr.patient_id = p.patient_id
                    ORDER BY dr.report_id DESC
                """)
                rows = cursor.fetchall()
            finally:
                cursor.close()
        finally:
            conn.close()
        db_error = None
    except Exception as e:
        rows = []
        db_error = str(e)

    if db_error:
        rows_html = f"""
        <tr><td colspan="8" style="text-align:center;padding:24px;color:#b91c1c;">
            Could not load records: {html.escape(db_error)}
        </td></tr>"""
    elif not rows:
        rows_html = """
        <tr><td colspan="8" style="text-align:center;padding:24px;color:#94a3b8;">
            No records saved yet. Run a scan from the home page first.
        </td></tr>"""
    else:
        rows_html = ""
        for r in rows:
            is_positive = "PNEUMONIA" in (r["final_diagnosis"] or "").upper()
            flag_class = "High" if is_positive else "Normal"
            created = r["created_at"].strftime("%d %b %Y, %I:%M %p") if r["created_at"] else "-"
            severity_val = r.get("severity") or "-"
            rows_html += f"""
            <tr>
                <td>{html.escape(r['report_code'] or '-')}</td>
                <td>{html.escape(r['full_name'] or '-')}</td>
                <td>{html.escape(str(r['age']) if r['age'] is not None else '-')}</td>
                <td>{html.escape(r['gender'] or '-')}</td>
                <td><span class="flag-pill {flag_class}">{html.escape(r['final_diagnosis'] or '-')}</span></td>
                <td>{r['confidence']}%</td>
                <td class="range-col">{html.escape(str(severity_val))}</td>
                <td class="range-col">{created}</td>
                <td><a href="/download?report_id={r['report_code']}" class="btn btn-outline" style="width:auto;padding:6px 14px;font-size:12.5px;display:inline-flex;">⬇ PDF</a></td>
            </tr>"""

    return f"""
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Saved Records &middot; Pneumonia Detection System</title>
<style>{BASE_CSS}</style>
</head>

<body>

<div class="shell">

  <div class="brand">
    <div class="logo">🫁</div>

    <h1>
      Pneumonia Detection System
      <span>All Saved Patients &amp; Reports</span>
    </h1>
  </div>

  <div class="card">
    <div class="card-pad">

      <div class="actions" style="margin-bottom:22px;">

        <a href="/" class="btn btn-outline">
          ↺ New Scan
        </a>

        <a href="http://localhost:8503" class="btn btn-outline">
           Go to Home
        </a>

      </div>

      <div class="lab-card">
        <table class="lab-table">

          <thead>
            <tr>
              <th>Report ID</th>
              <th>Patient</th>
              <th>Age</th>
              <th>Gender</th>
              <th>Result</th>
              <th>Confidence</th>
              <th>Severity</th>
              <th>Date</th>
              <th>PDF</th>
            </tr>
          </thead>

          <tbody>
            {rows_html}
          </tbody>

        </table>
      </div>

    </div>
  </div>

</div>

</body>
</html>
"""


def find_pdf_path(report_id: str):

    report_id = report_id.strip().upper()

    pdf_path = PDF_STORE.get(report_id)

    if pdf_path and os.path.isfile(pdf_path):
        return os.path.abspath(pdf_path)

    try:

        conn = get_connection()

        cursor = conn.cursor(dictionary=True)

        cursor.execute(
            """
            SELECT pdf_path
            FROM diagnosis_reports
            WHERE UPPER(report_code) = %s
            LIMIT 1
            """,
            (report_id,)
        )

        row = cursor.fetchone()

        cursor.close()
        conn.close()

        if row:

            print("Database row:", row)

            db_path = row.get("pdf_path")

            if db_path:

                db_path = os.path.normpath(db_path)

                print("PDF path from database:", db_path)

                if os.path.isfile(db_path):

                    PDF_STORE[report_id] = db_path

                    return os.path.abspath(db_path)

                reports_folder = os.path.join(
                    os.path.dirname(os.path.abspath(__file__)),
                    "reports"
                )

                filename = os.path.basename(db_path)

                local_pdf_path = os.path.join(
                    reports_folder,
                    filename
                )

                print(
                    "Checking local PDF:",
                    local_pdf_path
                )

                if os.path.isfile(local_pdf_path):

                    PDF_STORE[report_id] = local_pdf_path

                    return os.path.abspath(local_pdf_path)

    except Exception as e:

        print(
            "Database PDF lookup error:",
            e
        )

    reports_folder = os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "reports"
    )

    fallback_path = os.path.join(
        reports_folder,
        f"report_{report_id}.pdf"
    )

    print(
        "Checking fallback PDF:",
        fallback_path
    )

    if os.path.isfile(fallback_path):

        PDF_STORE[report_id] = fallback_path

        return os.path.abspath(fallback_path)

    print(
        "PDF NOT FOUND FOR REPORT:",
        report_id
    )

    return None


@app.get("/download")
def download_pdf(report_id: str = ""):

    if not report_id:
        raise HTTPException(
            status_code=400,
            detail="Report ID is required"
        )

    pdf_path = find_pdf_path(report_id)

    if not pdf_path:
        raise HTTPException(
            status_code=404,
            detail=f"PDF report not found for report ID: {report_id}"
        )

    return FileResponse(
        path=pdf_path,
        media_type="application/pdf",
        filename=os.path.basename(pdf_path),
        content_disposition_type="inline"
    )


@app.get("/download/{report_id}")
def view_pdf(report_id: str):

    if not report_id:
        raise HTTPException(
            status_code=400,
            detail="Report ID is required"
        )

    pdf_path = find_pdf_path(report_id)

    if not pdf_path:
        raise HTTPException(
            status_code=404,
            detail=f"PDF report not found for report ID: {report_id}"
        )

    return FileResponse(
        path=pdf_path,
        media_type="application/pdf",
        filename=os.path.basename(pdf_path),
        content_disposition_type="inline"
    )


@app.get("/patients")
def get_patients():
    conn = get_connection()
    try:
        cursor = conn.cursor(dictionary=True)
        try:
            cursor.execute("SELECT * FROM patients ORDER BY patient_id DESC")
            return cursor.fetchall()
        finally:
            cursor.close()
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
    finally:
        conn.close()


@app.get("/reports")
def get_reports():
    conn = get_connection()
    try:
        cursor = conn.cursor(dictionary=True)
        try:
            cursor.execute("SELECT * FROM diagnosis_reports ORDER BY report_id DESC")
            return cursor.fetchall()
        finally:
            cursor.close()
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
    finally:
        conn.close()